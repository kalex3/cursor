# Copy to `.env` (git-ignored) and fill in. Docker Compose reads it automatically.
#   cp .env.example .env

# API key for the Cursor CLI: https://cursor.com/dashboard -> API Keys -> New API Key
# Replace the placeholder, or delete/comment out this line to log in interactively instead
# (`agent login`, persisted in the cursor-state volume). A placeholder value would be sent as a (wrong) key.
CURSOR_API_KEY=crsr_your_api_key_here

# Print the login URL instead of trying to open a browser (there is none in the container).
NO_OPEN_BROWSER=1
