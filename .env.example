# Copy to `.env` (git-ignored) and fill in. Docker Compose reads it automatically.
#   cp .env.example .env

# API key for the Cursor CLI: https://cursor.com/dashboard -> API Keys -> New API Key
# Replace the placeholder, or delete/comment out this line to log in interactively instead
# (`agent login`, persisted in the cursor-state volume). A placeholder value would be sent as a (wrong) key.
CURSOR_API_KEY=crsr_your_api_key_here

# Print the login URL instead of trying to open a browser (there is none in the container).
NO_OPEN_BROWSER=1

# Optional: GitHub token for the `gh` CLI inside the container. Anything the agent runs can read it, so use a
# fine-grained personal access token limited to the repos and permissions you want the agent to have
# (e.g. contents/pull requests: read-write on one repo), never an admin or classic all-repo token.
# GH_TOKEN=github_pat_your_token_here

# Path to your WireGuard config for the `wg` service (default: ./wg0.conf). See https://github.com/kalex3/wg
# WG_CONFIG=./wg0.conf
